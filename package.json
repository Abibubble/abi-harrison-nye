{
  "name": "abi-harrison-nye",
  "version": "0.1.0",
  "private": true,
  "description": "Personal website of Abi Harrison-Nye",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@10.22.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "serve>compression": "^1.8.2",
      "@joshwooding/vite-plugin-react-docgen-typescript>glob": "^14.0.2"
    }
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "serve build/client --listen 4173 --no-clipboard",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"src/**/*.css\" --allow-empty-input",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:storybook": "vitest run --project storybook --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project chromium",
    "test:e2e:sample": "playwright test --project chromium --grep-invert @every-page",
    "test:lighthouse": "lhci autorun",
    "test:pages": "playwright test --config playwright.pages.config.ts",
    "storybook": "storybook dev --port 6006 --no-open",
    "build-storybook": "storybook build --quiet",
    "brand-images": "node scripts/brand-images.ts",
    "commit:check": "node scripts/check.ts && pnpm test:e2e:sample",
    "commit:check:full": "node scripts/check.ts && pnpm build-storybook && pnpm test:e2e && pnpm test:lighthouse"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@react-router/node": "^8.4.0",
    "isbot": "^5.2.2",
    "marked": "^18.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "^8.4.0",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-vitest": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.6",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "serve": "^14.2.7",
    "storybook": "^10.6.6",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
